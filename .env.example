# Contact form. Copy to `.env.local` (gitignored) and fill in.
#
# RESEND_API_KEY is server-only — it is read in src/app/api/contact/route.ts,
# which never runs in the browser. Do NOT prefix it with NEXT_PUBLIC_, which
# would inline it into the client bundle and publish it.
RESEND_API_KEY=

# Sender. Until a domain is verified in Resend, the only address it will send
# from is onboarding@resend.dev, and that can only deliver to the account owner.
CONTACT_FROM="Portfolio <onboarding@resend.dev>"

# Where messages land. Defaults to profile.email when unset.
CONTACT_TO=
