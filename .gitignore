# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- secrets ---------------------------------------------------------
# Every .env file is ignored. RESEND_API_KEY lives in .env.local and must
# never be committed — if you ever need to check, run:
#     git check-ignore -v .env.local
.env*
# ...except the example, which documents which keys are needed without
# holding any real values.
!.env.example

# vercel
.vercel

# firebase — deploy artifacts and the local emulator/runtime config, which
# can contain service-account details.
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
.runtimeconfig.json

# editors / OS
.vscode/
.idea/
*.swp
Thumbs.db

# typescript
*.tsbuildinfo
next-env.d.ts

# Agent instruction files. `next dev` regenerates AGENTS.md on every start, so
# these stay local rather than in the published repo.
AGENTS.md
CLAUDE.md
